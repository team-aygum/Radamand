from pathlib import Path

html = r'''<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="theme-color" content="#0b0d12">
<title>Radamand</title>
<style>
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
:root{
  --bg:#0b0d12;--panel:#141821;--panel2:#1b202b;--text:#f5f7fb;--muted:#9aa3b2;
  --accent:#6c63ff;--accent2:#8d85ff;--danger:#ff5364;--good:#40d695;
  --border:rgba(255,255,255,.09);--shadow:0 20px 60px rgba(0,0,0,.35)
}
html,body{margin:0;width:100%;height:100%;overflow:hidden;background:#050608;font-family:Inter,system-ui,-apple-system,BlinkMacSystemFont,"Segoe UI",sans-serif;color:var(--text)}
button,input,textarea,select{font:inherit}
button{border:0;color:inherit}
#phone{
  width:100vw;height:100vh;position:relative;overflow:hidden;background:var(--bg);
  max-width:520px;margin:auto;box-shadow:0 0 80px rgba(0,0,0,.45)
}
#wallpaper{position:absolute;inset:0;background:
 radial-gradient(circle at 20% 15%,rgba(108,99,255,.42),transparent 30%),
 radial-gradient(circle at 80% 75%,rgba(0,209,255,.20),transparent 35%),
 linear-gradient(145deg,#080a10,#101421 55%,#080a0f);transition:.3s}
#wallpaper.custom{background-size:cover;background-position:center}
#status{
 position:absolute;z-index:100;top:0;left:0;right:0;height:34px;padding:8px 18px 0;
 display:flex;justify-content:space-between;font-size:12px;font-weight:700;pointer-events:none
}
.statusRight{display:flex;gap:7px;align-items:center}
#screen{position:absolute;inset:34px 0 0;overflow:hidden}
.view{position:absolute;inset:0;display:none;overflow:auto}
.view.active{display:block}
#home{padding:18px 18px 100px}
.clock{font-size:54px;letter-spacing:-3px;font-weight:700;margin-top:12px}
.date{color:var(--muted);margin-bottom:28px}
.search{
 height:48px;border:1px solid var(--border);background:rgba(255,255,255,.09);backdrop-filter:blur(20px);
 border-radius:18px;display:flex;align-items:center;padding:0 15px;color:var(--muted);gap:10px;margin-bottom:25px
}
.apps{display:grid;grid-template-columns:repeat(4,1fr);gap:20px 12px}
.appIcon{background:transparent;display:flex;flex-direction:column;align-items:center;gap:7px;cursor:pointer}
.icon{
 width:58px;height:58px;border-radius:17px;display:grid;place-items:center;
 background:var(--panel2);border:1px solid var(--border);box-shadow:0 8px 20px rgba(0,0,0,.2)
}
.icon svg{width:29px;height:29px}
.appName{font-size:12px;max-width:80px;overflow:hidden;text-overflow:ellipsis;white-space:nowrap}
.dock{
 position:absolute;z-index:90;left:14px;right:14px;bottom:15px;height:73px;padding:8px 14px;
 border:1px solid var(--border);background:rgba(18,21,29,.78);backdrop-filter:blur(22px);
 border-radius:25px;display:grid;grid-template-columns:repeat(4,1fr);gap:10px
}
.dock .icon{width:52px;height:52px;margin:auto;border-radius:16px}
.header{
 position:sticky;top:0;z-index:10;height:64px;padding:8px 16px;display:flex;align-items:center;gap:12px;
 background:rgba(11,13,18,.84);backdrop-filter:blur(18px);border-bottom:1px solid var(--border)
}
.back{width:40px;height:40px;border-radius:13px;background:var(--panel2);display:grid;place-items:center;cursor:pointer}
.title{font-size:19px;font-weight:750;flex:1}
.headerAction{width:40px;height:40px;border-radius:13px;background:var(--panel2);display:grid;place-items:center;cursor:pointer}
.content{padding:16px}
.card{background:rgba(20,24,33,.92);border:1px solid var(--border);border-radius:20px;padding:16px;margin-bottom:12px}
.row{display:flex;align-items:center;gap:12px}
.muted{color:var(--muted)}
.small{font-size:12px}
button.primary{
 background:var(--accent);padding:12px 16px;border-radius:13px;font-weight:700;cursor:pointer
}
button.secondary{background:var(--panel2);padding:11px 14px;border-radius:13px;cursor:pointer}
button.danger{background:rgba(255,83,100,.14);color:#ff7885;padding:11px 14px;border-radius:13px;cursor:pointer}
input,textarea,select{
 width:100%;background:var(--panel2);border:1px solid var(--border);outline:none;color:var(--text);
 border-radius:13px;padding:12px 13px
}
textarea{resize:none;min-height:100px}
#toast{
 position:absolute;z-index:500;left:50%;bottom:105px;transform:translate(-50%,20px);
 background:#f3f5f8;color:#101217;padding:11px 16px;border-radius:13px;font-size:13px;font-weight:700;
 opacity:0;pointer-events:none;transition:.25s;white-space:nowrap;max-width:90%
}
#toast.show{opacity:1;transform:translate(-50%,0)}
/* Qlinux */
#qlinux .content{padding:0}
.chatLayout{height:calc(100vh - 98px);display:flex}
.chatList{width:42%;border-right:1px solid var(--border);overflow:auto}
.chatMessages{flex:1;display:flex;flex-direction:column;min-width:0}
.chatItem{padding:13px 11px;border-bottom:1px solid var(--border);cursor:pointer}
.chatItem.selected{background:rgba(108,99,255,.13)}
.avatar{width:42px;height:42px;border-radius:50%;background:linear-gradient(135deg,var(--accent),#2bd4ff);display:grid;place-items:center;font-weight:800;flex:none}
.chatTop{display:flex;gap:9px;align-items:center}
.chatName{font-size:13px;font-weight:750;white-space:nowrap;overflow:hidden;text-overflow:ellipsis}
.chatPreview{font-size:11px;color:var(--muted);white-space:nowrap;overflow:hidden;text-overflow:ellipsis;margin-top:3px}
.messages{flex:1;overflow:auto;padding:15px 11px;display:flex;flex-direction:column;gap:7px}
.bubble{max-width:82%;padding:9px 11px;border-radius:15px;font-size:13px;line-height:1.35}
.bubble.me{align-self:flex-end;background:var(--accent);border-bottom-right-radius:5px}
.bubble.them{align-self:flex-start;background:var(--panel2);border-bottom-left-radius:5px}
.msgImage{max-width:190px;border-radius:12px;display:block;margin-top:5px}
.composer{padding:9px;border-top:1px solid var(--border);display:flex;gap:7px}
.composer input{flex:1;border-radius:18px}
.circleBtn{width:42px;height:42px;border-radius:50%;background:var(--panel2);display:grid;place-items:center;cursor:pointer;flex:none}
/* store */
.storeHero{padding:20px;border-radius:22px;background:linear-gradient(135deg,rgba(108,99,255,.3),rgba(0,190,255,.08));border:1px solid var(--border);margin-bottom:15px}
.storeGrid{display:grid;gap:11px}
.storeApp{display:flex;align-items:center;gap:12px;padding:13px;background:var(--panel);border:1px solid var(--border);border-radius:18px}
.storeIcon{width:52px;height:52px;border-radius:15px;background:var(--panel2);display:grid;place-items:center;flex:none}
.storeInfo{min-width:0;flex:1}.storeInfo b{display:block}.storeInfo span{font-size:11px;color:var(--muted)}
.install{padding:9px 12px;border-radius:11px;background:var(--accent);font-size:12px;font-weight:750;cursor:pointer}
.install.installed{background:rgba(64,214,149,.14);color:var(--good)}
/* settings */
.setting{display:flex;align-items:center;gap:13px;padding:15px 2px;border-bottom:1px solid var(--border)}
.setting:last-child{border-bottom:0}
.settingIcon{width:40px;height:40px;border-radius:12px;background:var(--panel2);display:grid;place-items:center}
.settingInfo{flex:1}.settingInfo b{display:block;font-size:14px}.settingInfo span{display:block;color:var(--muted);font-size:11px;margin-top:2px}
.switch{width:46px;height:27px;background:#343945;border-radius:20px;padding:3px;cursor:pointer}
.switch i{display:block;width:21px;height:21px;border-radius:50%;background:white;transition:.2s}
.switch.on{background:var(--accent)}.switch.on i{transform:translateX(19px)}
/* map */
#map{position:absolute;inset:64px 0 0;background:#0d1118}
.mapOverlay{position:absolute;z-index:20;left:12px;right:12px;top:12px;display:flex;gap:8px}
.mapOverlay input{background:rgba(12,15,22,.9);backdrop-filter:blur(12px)}
.companyList{position:absolute;z-index:20;left:12px;right:12px;bottom:12px;max-height:180px;overflow:auto}
.companyCard{background:rgba(13,16,23,.92);backdrop-filter:blur(15px);border:1px solid var(--border);padding:11px;border-radius:15px;margin-top:7px;font-size:12px}
.leaflet-container{font-family:inherit!important}
/* code */
.editorWrap{padding:12px;height:calc(100vh - 98px);display:flex;flex-direction:column;gap:9px}
.projectBar{display:flex;gap:7px}.projectBar select{flex:1}
#codeEditor{flex:1;min-height:0;font-family:"SFMono-Regular",Consolas,monospace;font-size:12px;line-height:1.5;tab-size:2;background:#090b10}
.codeOutput{height:130px;overflow:auto;background:#07090d;border:1px solid var(--border);border-radius:14px;padding:10px;font-family:monospace;font-size:11px;color:#b8c1d1}
/* assistant */
.assistant{display:flex;flex-direction:column;height:calc(100vh - 98px)}
.assistantOrb{width:105px;height:105px;border-radius:50%;margin:35px auto 12px;background:radial-gradient(circle at 35% 30%,#fff, #9a91ff 12%,#6c63ff 45%,#171a40 75%);box-shadow:0 0 60px rgba(108,99,255,.45);animation:float 3s ease-in-out infinite}
@keyframes float{50%{transform:translateY(-7px);box-shadow:0 0 80px rgba(108,99,255,.6)}}
.assistantStatus{text-align:center;color:var(--muted);font-size:12px}
.assistantLog{flex:1;overflow:auto;padding:15px}
.aiBubble{background:var(--panel2);padding:12px 14px;border-radius:16px;margin-bottom:8px;font-size:13px}
.aiBubble.me{background:var(--accent);margin-left:35px}
.aiControls{padding:11px;border-top:1px solid var(--border);display:flex;gap:7px}
.aiControls input{flex:1}
/* lock */
#lock{position:absolute;z-index:200;inset:0;display:none;align-items:center;justify-content:center;text-align:center;background:rgba(5,7,11,.58);backdrop-filter:blur(25px)}
#lock.show{display:flex}.lockTime{font-size:65px;font-weight:300;letter-spacing:-4px}.lockDate{color:#d5dae4;margin-bottom:30px}
.unlock{width:62px;height:62px;border-radius:50%;background:rgba(255,255,255,.12);display:grid;place-items:center;margin:auto;cursor:pointer}
@media(min-width:600px){#phone{height:100vh;border-left:1px solid var(--border);border-right:1px solid var(--border)}}
</style>
<link rel="stylesheet" href="https://unpkg.com/leaflet@1.9.4/dist/leaflet.css">
</head>
<body>
<div id="phone">
<div id="wallpaper"></div>
<div id="status"><span id="statusTime">09:41</span><span class="statusRight"><span>▮▮▮</span><span>⌁</span><span>100%</span></span></div>

<div id="screen">
<section id="home" class="view active">
  <div class="clock" id="homeClock">09:41</div>
  <div class="date" id="homeDate">Monday, August 24</div>
  <div class="search" onclick="toast('Search is ready for the next version')">
    <span data-icon="search"></span><span>Search Radamand</span>
  </div>
  <div class="apps" id="homeApps"></div>
</section>

<section id="settings" class="view">
 <div class="header"><button class="back" onclick="goHome()" data-icon="back"></button><div class="title">Settings</div></div>
 <div class="content">
  <div class="card">
   <div class="setting"><div class="settingIcon" data-icon="palette"></div><div class="settingInfo"><b>Wallpaper</b><span>Use an image from your device</span></div><button class="secondary" onclick="pickWallpaper()">Choose</button></div>
   <div class="setting"><div class="settingIcon" data-icon="moon"></div><div class="settingInfo"><b>Dark interface</b><span>Radamand night appearance</span></div><div class="switch on" id="darkSwitch" onclick="toggleDark()"><i></i></div></div>
   <div class="setting"><div class="settingIcon" data-icon="volume"></div><div class="settingInfo"><b>Interface sounds</b><span>Tap and notification sounds</span></div><div class="switch on" id="soundSwitch" onclick="toggleSound()"><i></i></div></div>
   <div class="setting"><div class="settingIcon" data-icon="globe"></div><div class="settingInfo"><b>Language</b><span>Application language</span></div><select id="lang" onchange="setLang(this.value)" style="width:95px"><option value="en">English</option><option value="ru">Русский</option></select></div>
  </div>
  <div class="card"><b>Radamand account</b><p class="muted small">This prototype stores its local data in your browser. A real multi-user account requires a backend.</p><button class="primary" onclick="toast('Account backend can be connected later')">Account</button></div>
  <div class="card"><b>About Radamand</b><p class="muted small">A web-based phone environment with installable apps.</p><button class="danger" onclick="resetRadamand()">Reset local data</button></div>
 </div>
</section>

<section id="randplus" class="view">
 <div class="header"><button class="back" onclick="goHome()" data-icon="back"></button><div class="title">RandPlus</div></div>
 <div class="content">
  <div class="storeHero"><b style="font-size:22px">RandPlus</b><div class="muted small" style="margin-top:5px">Install useful apps for your Radamand phone.</div></div>
  <div class="storeGrid" id="storeGrid"></div>
 </div>
</section>

<section id="qlinux" class="view">
 <div class="header"><button class="back" onclick="goHome()" data-icon="back"></button><div class="title">Qlinux</div><button class="headerAction" onclick="newChat()" data-icon="plus"></button></div>
 <div class="content">
  <div class="chatLayout">
   <div class="chatList" id="chatList"></div>
   <div class="chatMessages">
    <div id="chatHeader" style="padding:12px;border-bottom:1px solid var(--border);font-weight:750">Select a chat</div>
    <div class="messages" id="messages"></div>
    <div class="composer">
      <button class="circleBtn" onclick="document.getElementById('photoInput').click()" data-icon="image"></button>
      <input id="messageInput" placeholder="Message..." onkeydown="if(event.key==='Enter')sendMessage()">
      <button class="circleBtn" onclick="sendMessage()" data-icon="send"></button>
    </div>
   </div>
  </div>
 </div>
 <input id="photoInput" type="file" accept="image/*" hidden onchange="sendPhoto(this.files[0])">
</section>

<section id="banana" class="view">
 <div class="header"><button class="back" onclick="goHome()" data-icon="back"></button><div class="title">BananaCipr</div></div>
 <div id="map"></div>
 <div class="mapOverlay"><input id="mapSearch" placeholder="Search company or city..." oninput="filterCompanies()"></div>
 <div class="companyList" id="companyList"></div>
</section>

<section id="codkey" class="view">
 <div class="header"><button class="back" onclick="goHome()" data-icon="back"></button><div class="title">CodKey+</div><button class="headerAction" onclick="newProject()" data-icon="plus"></button></div>
 <div class="editorWrap">
  <div class="projectBar"><select id="projectSelect" onchange="loadProject()"></select><button class="secondary" onclick="saveProject()">Save</button><button class="primary" onclick="runCode()">Run</button></div>
  <textarea id="codeEditor" spellcheck="false"></textarea>
  <div class="codeOutput" id="codeOutput">CodKey+ console ready.</div>
 </div>
</section>

<section id="robotalim" class="view">
 <div class="header"><button class="back" onclick="goHome()" data-icon="back"></button><div class="title">Robotalim</div></div>
 <div class="assistant">
  <div class="assistantOrb"></div><div class="assistantStatus" id="aiStatus">Ready to help</div>
  <div class="assistantLog" id="aiLog"></div>
  <div class="aiControls"><button class="circleBtn" onclick="voiceInput()" data-icon="mic"></button><input id="aiInput" placeholder="Talk to Robotalim..." onkeydown="if(event.key==='Enter')askAI()"><button class="circleBtn" onclick="askAI()" data-icon="send"></button></div>
 </div>
</section>
</div>

<div class="dock" id="dock"></div>
<div id="toast"></div>
<div id="lock"><div><div class="lockTime" id="lockTime">09:41</div><div class="lockDate" id="lockDate"></div><div class="unlock" onclick="unlock()" data-icon="lock"></div><div style="margin-top:12px;color:#cdd3df;font-size:12px">Tap to unlock</div></div></div>
<input id="wallpaperInput" type="file" accept="image/*" hidden onchange="applyWallpaper(this.files[0])">

<script>
const icons={
 back:`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M15 18l-6-6 6-6"/></svg>`,
 settings:`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M12 15.2a3.2 3.2 0 1 0 0-6.4 3.2 3.2 0 0 0 0 6.4Z"/><path d="m19.4 15 .1.1-1.5 2.6-.1-.1c-.7.4-1.4.7-2.2.9v.1h-3v-.1c-.8-.2-1.5-.5-2.2-.9l-.1.1-2.6-1.5.1-.1c-.4-.7-.7-1.4-.9-2.2H7v-3h.1c.2-.8.5-1.5.9-2.2l-.1-.1 1.5-2.6.1.1c.7-.4 1.4-.7 2.2-.9V5h3v.1c.8.2 1.5.5 2.2.9l.1-.1 2.6 1.5-.1.1c.4.7.7 1.4.9 2.2h.1v3h-.1c-.2.8-.5 1.5-.9 2.2Z"/></svg>`,
 store:`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 9h14l-1 11H6L5 9Z"/><path d="M8 9a4 4 0 0 1 8 0"/></svg>`,
 chat:`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 18.5 4 21l3.2-1.3A8.6 8.6 0 1 0 5 18.5Z"/></svg>`,
 map:`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m9 18-5 2V6l5-2 6 2 5-2v14l-5 2-6-2Z"/><path d="M9 4v14M15 6v14"/></svg>`,
 code:`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m8 9-4 3 4 3M16 9l4 3-4 3M14 5l-4 14"/></svg>`,
 bot:`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><rect x="4" y="7" width="16" height="12" rx="3"/><path d="M12 3v4M8 12h.01M16 12h.01M8 16h8"/></svg>`,
 search:`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><circle cx="11" cy="11" r="6.5"/><path d="m16 16 4 4"/></svg>`,
 plus:`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2"><path d="M12 5v14M5 12h14"/></svg>`,
 image:`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="4" y="5" width="16" height="14" rx="2"/><circle cx="9" cy="10" r="1.5"/><path d="m5 17 4-4 3 3 2-2 5 4"/></svg>`,
 send:`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="m4 4 16 8-16 8 3-8-3-8Z"/><path d="M7 12h13"/></svg>`,
 mic:`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="9" y="3" width="6" height="11" rx="3"/><path d="M5 11a7 7 0 0 0 14 0M12 18v3M8 21h8"/></svg>`,
 palette:`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.7"><path d="M12 4a8 8 0 0 0 0 16h1.5a2 2 0 0 0 0-4H12a2 2 0 0 1 0-4h2a6 6 0 0 0-2-8Z"/><circle cx="7.5" cy="10" r=".8"/><circle cx="9" cy="6.8" r=".8"/><circle cx="13" cy="6.5" r=".8"/></svg>`,
 moon:`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M20 15.2A8.5 8.5 0 0 1 8.8 4 8.5 8.5 0 1 0 20 15.2Z"/></svg>`,
 volume:`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><path d="M5 10h3l4-4v12l-4-4H5v-4ZM16 9a4 4 0 0 1 0 6M18.5 6.5a7.5 7.5 0 0 1 0 11"/></svg>`,
 globe:`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><circle cx="12" cy="12" r="8.5"/><path d="M3.5 12h17M12 3.5c2.2 2.3 3.2 5.1 3.2 8.5s-1 6.2-3.2 8.5c-2.2-2.3-3.2-5.1-3.2-8.5s1-6.2 3.2-8.5Z"/></svg>`,
 lock:`<svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.8"><rect x="5" y="10" width="14" height="10" rx="2"/><path d="M8 10V7a4 4 0 0 1 8 0v3"/></svg>`
};
function paintIcons(){
 document.querySelectorAll("[data-icon]").forEach(el=>{const k=el.dataset.icon;if(icons[k])el.innerHTML=icons[k]});
}
const apps=[
 {id:"randplus",name:"RandPlus",icon:"store",desc:"App store"},
 {id:"qlinux",name:"Qlinux",icon:"chat",desc:"Messenger"},
 {id:"banana",name:"BananaCipr",icon:"map",desc:"World map"},
 {id:"codkey",name:"CodKey+",icon:"code",desc:"Code editor"},
 {id:"robotalim",name:"Robotalim",icon:"bot",desc:"AI assistant"},
 {id:"settings",name:"Settings",icon:"settings",desc:"Phone settings"}
];
let state=JSON.parse(localStorage.getItem("radamand")||"null")||{
 installed:["randplus","settings"],sound:true,dark:true,wallpaper:"",
 chats:[{id:1,name:"Welcome",messages:[{from:"them",text:"Welcome to Qlinux 👋"}]}],
 projects:[{name:"Hello.js",code:"console.log('Hello from CodKey+');"}]
};
let selectedChat=state.chats[0]?.id||null;

function persist(){localStorage.setItem("radamand",JSON.stringify(state))}
function toast(t){const e=document.getElementById("toast");e.textContent=t;e.classList.add("show");clearTimeout(window.tt);window.tt=setTimeout(()=>e.classList.remove("show"),1800)}
function clickSound(){if(!state.sound)return;try{const a=new AudioContext(),o=a.createOscillator(),g=a.createGain();o.frequency.value=520;g.gain.value=.025;o.connect(g);g.connect(a.destination);o.start();o.stop(a.currentTime+.035)}catch{}}
document.addEventListener("click",e=>{if(e.target.closest("button,.appIcon,.chatItem,.install,.switch"))clickSound()});
function go(id){
 document.querySelectorAll(".view").forEach(v=>v.classList.remove("active"));
 const el=document.getElementById(id);if(el)el.classList.add("active");
 if(id==="qlinux")renderChats();
 if(id==="randplus")renderStore();
 if(id==="codkey")renderProjects();
 if(id==="banana")setTimeout(initMap,50);
}
function goHome(){go("home")}
function renderHome(){
 const box=document.getElementById("homeApps");box.innerHTML="";
 apps.filter(a=>state.installed.includes(a.id)).forEach(a=>{
  const d=document.createElement("div");d.className="appIcon";d.onclick=()=>go(a.id);
  d.innerHTML=`<div class="icon">${icons[a.icon]}</div><div class="appName">${a.name}</div>`;box.appendChild(d)
 });
 document.getElementById("dock").innerHTML=["qlinux","randplus","robotalim","settings"].map(id=>{
  const a=apps.find(x=>x.id===id);return `<button class="appIcon" onclick="go('${id}')"><div class="icon">${icons[a.icon]}</div></button>`
 }).join("");
}
function renderStore(){
 const box=document.getElementById("storeGrid");box.innerHTML="";
 apps.filter(a=>a.id!=="settings"&&a.id!=="randplus").forEach(a=>{
  const installed=state.installed.includes(a.id);
  box.innerHTML+=`<div class="storeApp"><div class="storeIcon">${icons[a.icon]}</div><div class="storeInfo"><b>${a.name}</b><span>${a.desc}</span></div><button class="install ${installed?"installed":""}" onclick="installApp('${a.id}')">${installed?"Installed":"Install"}</button></div>`
 })
}
function installApp(id){
 if(!state.installed.includes(id)){state.installed.push(id);persist();renderStore();renderHome();toast("App installed")}
}
function pickWallpaper(){document.getElementById("wallpaperInput").click()}
function applyWallpaper(file){
 if(!file)return;const r=new FileReader();r.onload=e=>{state.wallpaper=e.target.result;persist();applySavedWallpaper();toast("Wallpaper changed")};r.readAsDataURL(file)
}
function applySavedWallpaper(){if(state.wallpaper){const w=document.getElementById("wallpaper");w.style.backgroundImage=`url("${state.wallpaper}")`;w.classList.add("custom")}}
function toggleSound(){state.sound=!state.sound;document.getElementById("soundSwitch").classList.toggle("on",state.sound);persist()}
function toggleDark(){state.dark=!state.dark;document.getElementById("darkSwitch").classList.toggle("on",state.dark);document.documentElement.style.setProperty("--bg",state.dark?"#0b0d12":"#f2f4f8");document.documentElement.style.setProperty("--text",state.dark?"#f5f7fb":"#11141a");persist()}
function setLang(v){toast(v==="en"?"English selected":"Русский выбран");}
function resetRadamand(){if(confirm("Reset Radamand local data?")){localStorage.removeItem("radamand");location.reload()}}
function newChat(){
 const name=prompt("Chat name:");if(!name)return;
 const id=Date.now();state.chats.unshift({id,name,messages:[]});selectedChat=id;persist();renderChats()
}
function deleteChat(id){
 if(!confirm("Delete this chat?"))return;
 state.chats=state.chats.filter(c=>c.id!==id);selectedChat=state.chats[0]?.id||null;persist();renderChats()
}
function renderChats(){
 const list=document.getElementById("chatList");list.innerHTML=state.chats.map(c=>`
 <div class="chatItem ${c.id===selectedChat?"selected":""}" onclick="selectChat(${c.id})">
  <div class="chatTop"><div class="avatar">${escapeHtml(c.name[0]||"Q")}</div><div style="min-width:0"><div class="chatName">${escapeHtml(c.name)}</div><div class="chatPreview">${escapeHtml(c.messages.at(-1)?.text||"No messages yet")}</div></div></div>
 </div>`).join("");
 renderMessages()
}
function selectChat(id){selectedChat=id;renderChats()}
function renderMessages(){
 const c=state.chats.find(x=>x.id===selectedChat), box=document.getElementById("messages"),head=document.getElementById("chatHeader");
 if(!c){head.textContent="Select a chat";box.innerHTML="";return}
 head.innerHTML=`<div style="display:flex;align-items:center;justify-content:space-between"><span>${escapeHtml(c.name)}</span><button class="danger" onclick="deleteChat(${c.id})">Delete</button></div>`;
 box.innerHTML=c.messages.map(m=>`<div class="bubble ${m.from==="me"?"me":"them"}">${m.text?escapeHtml(m.text):""}${m.image?`<img class="msgImage" src="${m.image}">`:""}</div>`).join("");
 box.scrollTop=box.scrollHeight
}
function sendMessage(){
 const inp=document.getElementById("messageInput"),text=inp.value.trim(),c=state.chats.find(x=>x.id===selectedChat);if(!text||!c)return;
 c.messages.push({from:"me",text});inp.value="";persist();renderChats();
 setTimeout(()=>{c.messages.push({from:"them",text:"Message received. Qlinux local mode is working."});persist();renderChats()},450)
}
function sendPhoto(file){
 const c=state.chats.find(x=>x.id===selectedChat);if(!file||!c)return;
 const r=new FileReader();r.onload=e=>{c.messages.push({from:"me",image:e.target.result});persist();renderChats()};r.readAsDataURL(file)
}
function renderProjects(){
 const s=document.getElementById("projectSelect");s.innerHTML=state.projects.map((p,i)=>`<option value="${i}">${escapeHtml(p.name)}</option>`).join("");loadProject()
}
function loadProject(){const p=state.projects[document.getElementById("projectSelect").value];if(p)document.getElementById("codeEditor").value=p.code}
function saveProject(){const i=+document.getElementById("projectSelect").value,p=state.projects[i];if(!p)return;p.code=document.getElementById("codeEditor").value;persist();toast("Project saved")}
function newProject(){const n=prompt("Project file name:","New.js");if(!n)return;state.projects.push({name:n,code:"// New Radamand project\\n"});persist();renderProjects();document.getElementById("projectSelect").value=state.projects.length-1;loadProject()}
function runCode(){
 const code=document.getElementById("codeEditor").value,out=document.getElementById("codeOutput");
 const logs=[];const fakeConsole={log:(...x)=>logs.push(x.map(String).join(" ")),warn:(...x)=>logs.push("WARN: "+x.join(" ")),error:(...x)=>logs.push("ERROR: "+x.join(" "))};
 try{new Function("console",code)(fakeConsole);out.textContent=logs.join("\\n")||"Code executed successfully."}catch(e){out.textContent="Error: "+e.message}
}
/* Leaflet map */
let map,markers=[];
const companies=[
 ["Apple","Cupertino, USA",37.3349,-122.0090],["Google","Mountain View, USA",37.4220,-122.0841],
 ["Microsoft","Redmond, USA",47.6740,-122.1215],["Amazon","Seattle, USA",47.6062,-122.3321],
 ["Meta","Menlo Park, USA",37.4848,-122.1484],["Samsung","Suwon, South Korea",37.2636,127.0286],
 ["Sony","Tokyo, Japan",35.6895,139.6917],["Nintendo","Kyoto, Japan",35.0116,135.7681],
 ["Toyota","Toyota, Japan",35.0833,137.1563],["Siemens","Munich, Germany",48.1351,11.5820],
 ["SAP","Walldorf, Germany",49.2933,8.6390],["BMW","Munich, Germany",48.1760,11.5560],
 ["Volkswagen","Wolfsburg, Germany",52.4227,10.7865],["ASML","Veldhoven, Netherlands",51.4210,5.4067],
 ["Spotify","Stockholm, Sweden",59.3293,18.0686],["IKEA","Älmhult, Sweden",56.5515,14.1380],
 ["Airbus","Toulouse, France",43.6047,1.4442],["LVMH","Paris, France",48.8566,2.3522],
 ["Alibaba","Hangzhou, China",30.2741,120.1551],["Tencent","Shenzhen, China",22.5431,114.0579],
 ["ByteDance","Beijing, China",39.9042,116.4074],["TSMC","Hsinchu, Taiwan",24.8138,120.9675],
 ["Sony","Tokyo, Japan",35.6762,139.6503],["Infosys","Bengaluru, India",12.9716,77.5946],
 ["Tata","Mumbai, India",19.0760,72.8777],["Canva","Sydney, Australia",-33.8688,151.2093],
 ["Atlassian","Sydney, Australia",-33.8688,151.2093],["NVIDIA","Santa Clara, USA",37.3541,-121.9552],
 ["OpenAI","San Francisco, USA",37.7749,-122.4194],["SpaceX","Hawthorne, USA",33.9164,-118.3526]
];
function initMap(){
 if(typeof L==="undefined")return;
 if(!map){
  map=L.map("map",{zoomControl:false,worldCopyJump:true}).setView([25,10],2);
  L.tileLayer("https://{s}.tile.openstreetmap.org/{z}/{x}/{y}.png",{maxZoom:19,attribution:"© OpenStreetMap"}).addTo(map);
 }
 map.invalidateSize();renderCompanies(companies)
}
function renderCompanies(arr){
 if(!map)return;markers.forEach(m=>map.removeLayer(m));markers=[];
 arr.forEach(c=>{const m=L.marker([c[2],c[3]]).addTo(map).bindPopup(`<b>${escapeHtml(c[0])}</b><br>${escapeHtml(c[1])}`);markers.push(m)});
 document.getElementById("companyList").innerHTML=arr.slice(0,12).map(c=>`<div class="companyCard" onclick="map.setView([${c[2]},${c[3]}],10);markers.find(m=>m.getLatLng().lat===${c[2]}&&m.getLatLng().lng===${c[3]})?.openPopup()"><b>${escapeHtml(c[0])}</b> <span class="muted">— ${escapeHtml(c[1])}</span></div>`).join("")
}
function filterCompanies(){const q=document.getElementById("mapSearch").value.toLowerCase();renderCompanies(companies.filter(c=>(c[0]+" "+c[1]).toLowerCase().includes(q)))}
/* Robotalim */
function askAI(){
 const inp=document.getElementById("aiInput"),q=inp.value.trim();if(!q)return;inp.value="";
 addAI(q,true);document.getElementById("aiStatus").textContent="Thinking…";
 setTimeout(()=>{const a=aiReply(q);addAI(a,false);document.getElementById("aiStatus").textContent="Ready to help";speak(a)},350)
}
function addAI(text,me){const b=document.createElement("div");b.className="aiBubble"+(me?" me":"");b.textContent=text;document.getElementById("aiLog").appendChild(b);document.getElementById("aiLog").scrollTop=99999}
function aiReply(q){
 const x=q.toLowerCase();
 if(x.includes("settings")){go("settings");return"I opened Settings for you."}
 if(x.includes("qLinux".toLowerCase())||x.includes("chat")){go("qlinux");return"I opened Qlinux."}
 if(x.includes("map")||x.includes("company")){go("banana");return"I opened BananaCipr."}
 if(x.includes("code")||x.includes("codkey")){go("codkey");return"I opened CodKey+."}
 if(x.includes("store")||x.includes("randplus")){go("randplus");return"I opened RandPlus."}
 if(x.includes("hello")||x.includes("hi"))return"Hello! I'm Robotalim, your Radamand assistant.";
 return"I can control the Radamand interface, open apps, and help you use the phone. Try saying “open settings”, “open map”, or “open Qlinux”."
}
function speak(t){if("speechSynthesis"in window){speechSynthesis.cancel();const u=new SpeechSynthesisUtterance(t);u.lang=state.lang==="ru"?"ru-RU":"en-US";speechSynthesis.speak(u)}}
function voiceInput(){
 const SR=window.SpeechRecognition||window.webkitSpeechRecognition;if(!SR){toast("Voice recognition is not supported here");return}
 const r=new SR();r.lang="en-US";document.getElementById("aiStatus").textContent="Listening…";r.start();
 r.onresult=e=>{document.getElementById("aiInput").value=e.results[0][0].transcript;askAI()};r.onerror=()=>document.getElementById("aiStatus").textContent="Ready to help"
}
function escapeHtml(s){return String(s).replace(/[&<>"']/g,m=>({"&":"&amp;","<":"&lt;",">":"&gt;",'"':"&quot;","'":"&#039;"}[m]))}
function tick(){
 const d=new Date(),time=d.toLocaleTimeString([], {hour:"2-digit",minute:"2-digit"});
 document.getElementById("homeClock").textContent=time;document.getElementById("statusTime").textContent=time;
 document.getElementById("homeDate").textContent=d.toLocaleDateString("en-US",{weekday:"long",month:"long",day:"numeric"});
 document.getElementById("lockTime").textContent=time;document.getElementById("lockDate").textContent=d.toLocaleDateString("en-US",{weekday:"long",month:"long",day:"numeric"})
}
function lock(){document.getElementById("lock").classList.add("show")}
function unlock(){document.getElementById("lock").classList.remove("show")}
function boot(){
 paintIcons();renderHome();applySavedWallpaper();tick();setInterval(tick,1000);
 document.getElementById("lang").value="en";
}
boot();
</script>
<script src="https://unpkg.com/leaflet@1.9.4/dist/leaflet.js"></script>
</div>
</body>
</html>
'''
path = Path("/mnt/data/radamand.html")
path.write_text(html, encoding="utf-8")
print(f"Готово: {path}")
print(f"Размер: {len(html):,} символов")
